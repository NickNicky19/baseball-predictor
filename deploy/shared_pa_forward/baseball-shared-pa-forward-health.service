[Unit]
Description=Verify immutable shared batter PA evidence health (research only)
After=baseball-shared-pa-forward-tick.service

[Service]
Type=oneshot
User=baseball-shadow
Group=baseball-shadow
WorkingDirectory=/opt/baseball-predictor-shared-pa-forward/current
ExecStart=/usr/bin/python3 /opt/baseball-predictor-shared-pa-forward/current/scripts/report_aws_shared_pa_forward_health.py --plan-dir /srv/baseball-shadow/pitcher-receipts/plans --ledger-root /srv/baseball-shadow/shared-pa-forward/ledgers --health-root /srv/baseball-shadow/shared-pa-forward/health

NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/baseball-shadow/pitcher-receipts/plans
ReadWritePaths=/srv/baseball-shadow/shared-pa-forward
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
UMask=0027
