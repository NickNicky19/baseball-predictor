[Unit]
Description=Report shared-PA comparator automation health (outcome-free)
After=baseball-shared-pa-comparator-finalize.service

[Service]
Type=oneshot
User=baseball-shadow
Group=baseball-shadow
WorkingDirectory=/srv/baseball-shadow/shared-pa-comparators/runtime
EnvironmentFile=-/srv/baseball-shadow/shared-pa-comparators/secrets/provider.env
ExecStart=/opt/baseball-predictor-shared-pa-comparators/current-venv/bin/python /opt/baseball-predictor-shared-pa-comparators/current/scripts/report_aws_shared_pa_comparator_health.py --plan-dir /srv/baseball-shadow/pitcher-receipts/plans --evidence-root /srv/baseball-shadow/shared-pa-comparators --report-dir /srv/baseball-shadow/shared-pa-comparators/health

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/baseball-shadow/pitcher-receipts/plans
ReadWritePaths=/srv/baseball-shadow/shared-pa-comparators/health
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
UMask=0027
