[Unit]
Description=Baseball projected-lineup postgame label tick
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=baseball-shadow
Group=baseball-shadow
WorkingDirectory=/opt/baseball-predictor-projected-lineup-label/current
UMask=0027
ExecStart=/usr/bin/python3 /opt/baseball-predictor-projected-lineup-label/current/scripts/run_aws_projected_lineup_label_tick.py --plan-dir /srv/baseball-shadow/pitcher-receipts/plans --roster-ledger-root /srv/baseball-shadow/projected-lineup-roster-receipts --label-ledger-root /srv/baseball-shadow/projected-lineup-label-receipts

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/srv/baseball-shadow/projected-lineup-roster-receipts
ReadWritePaths=/srv/baseball-shadow/projected-lineup-label-receipts
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
