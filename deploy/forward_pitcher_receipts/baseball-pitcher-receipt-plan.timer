[Unit]
Description=Publish tomorrow's MLB T-4 probable-starter receipt plan before any target is due

[Timer]
OnCalendar=*-*-* 00:15:00 America/New_York
# Never catch up a missed daily plan after boot or late deployment. The plan
# builder independently refuses any date whose first T-4 target is already due.
Persistent=false
Unit=baseball-pitcher-receipt-plan.service

[Install]
WantedBy=timers.target
