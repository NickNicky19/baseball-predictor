[Unit]
Description=Write immutable health report for AWS pitcher receipt collector
After=baseball-pitcher-receipt-tick.service

[Service]
Type=oneshot
User=baseball-shadow
Group=baseball-shadow
WorkingDirectory=/opt/baseball-predictor
ExecStart=/usr/bin/python3 /opt/baseball-predictor/scripts/report_aws_pitcher_receipt_health.py --plan-dir /srv/baseball-shadow/pitcher-receipts/plans --ledger-root /srv/baseball-shadow/pitcher-receipts/ledgers --report-dir /srv/baseball-shadow/pitcher-receipts/health

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/baseball-shadow/pitcher-receipts
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0027
