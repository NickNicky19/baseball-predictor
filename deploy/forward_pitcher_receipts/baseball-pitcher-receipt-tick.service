[Unit]
Description=Run one official MLB probable-starter T-4 receipt tick (research only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=baseball-shadow
Group=baseball-shadow
WorkingDirectory=/opt/baseball-predictor
ExecStart=/usr/bin/python3 /opt/baseball-predictor/scripts/run_aws_pitcher_receipt_tick.py --plan-dir /srv/baseball-shadow/pitcher-receipts/plans --ledger-root /srv/baseball-shadow/pitcher-receipts/ledgers --lock-file /srv/baseball-shadow/pitcher-receipts/locks/tick.lock

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/baseball-shadow/pitcher-receipts
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0027
