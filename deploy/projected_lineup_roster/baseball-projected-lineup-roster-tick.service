[Unit]
Description=Baseball projected-lineup T-4 active-roster receipt tick
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=baseball-shadow
Group=baseball-shadow
# This collector deliberately has an independent immutable release tree.  It
# must never share the live pitcher/shared-PA release symlink.
WorkingDirectory=/opt/baseball-predictor-projected-lineup-roster/current
UMask=0027
ExecStart=/usr/bin/python3 /opt/baseball-predictor-projected-lineup-roster/current/scripts/run_aws_projected_lineup_roster_tick.py --plan-dir /srv/baseball-shadow/pitcher-receipts/plans --ledger-root /srv/baseball-shadow/projected-lineup-roster-receipts

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/baseball-shadow/projected-lineup-roster-receipts
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
