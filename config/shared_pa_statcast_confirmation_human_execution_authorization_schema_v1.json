        "workflow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority_package_sha256": {"const": "31181de53446951a4d48c5740e4687c36fb042005e1466ff09a9ac9e1cf3ef0d"},
        "execution_contract_sha256": {"const": "851e02beab8732b8f6d1a242ea4609d30ab1f3b462804134ae8194b3d42dc510"},
        "attempt_ledger_sha256": {"const": "4f7aea30afdbff76fedd695ef3bd83bb23e5395f4db9496405552433695d9c56"},
        "runtime_authority_sha256": {"const": "f348f1baf664fa12c821eb488b4ff4c8fb293b3e243d713600efcd0da96fbf2a"},
        "source_bundle_sha256": {"const": "81861595f8eb4b83772220bdad2fb556fc06ec3640a1a4f2084255e8f5183033"},
        "carrier_commit": {"const": "a8ebc64eddf8ace3a48e25af57ee0d6658d0663a"},
        "source_contract_v1_sha256": {"const": "7078857cc1815e5c8dcecd667a9b6d69079ef31c1fc68057473d1fb1dc9ceebd"},
        "source_contract_v2_proposal_sha256": {"const": "166c49a5ea66bf4491c9d04c7f233c7bc51c032683b9883b695236dabc637328"},
        "request_plan_sha256": {"const": "0bcc3c9482ea67189e414502b9b58e6445cd66efeb27c309c5bcff4864108402"},
        "full_request_url_sha256": {"const": "0efc234b3ef8e8490550bc11a28896bbc1e85ca39b31bf503484c65ed9d96aa9"},
        "query_sha256": {"const": "16920ee504c363fb27b19b7100d8fc54c95649054a9357af887e4ab51ef58e23"}
