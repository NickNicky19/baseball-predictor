    },
    "authorized_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "numeric_user_id"],
      "properties": {
        "login": {"const": "NickNicky19"},
        "numeric_user_id": {"const": 208912933}
      }
    },
    "bindings": {
