{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-pa-statcast-confirmation-human-execution-authorization-schema-v1",
  "title": "One-time human execution authorization for June 28 Statcast confirmation attempt 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authorization_id",
    "repository",
    "authorized_actor",
    "bindings",
    "scope",
    "validity",
    "canonical_human_authorization_text",
    "canonical_human_authorization_text_sha256",
