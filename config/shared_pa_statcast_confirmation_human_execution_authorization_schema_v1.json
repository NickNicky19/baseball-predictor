    "future_record_pr_exact_changed_path_count": 1,
    "validity_interval_maximum_seconds": 1800,
    "canonical_text_encoding": "UTF-8 without BOM or CR, exactly one terminal LF, no trailing horizontal whitespace",
    "record_cannot_authorize_itself": true,
    "authorization_base_main_commit_semantics": "first parent B of the later protected one-file authorization-record merge commit",
    "dispatch_commit_is_runtime_input_not_record_field": true,
    "record_must_not_embed_own_sha_blob_tree_pr_head_or_merge_commit": true,
    "current_gate_implementation_contains_executable_record": false
