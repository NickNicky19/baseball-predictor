{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-pa-experiment-registry-release-expectation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_id", "registry_id", "source_base_commit", "policy_binding", "evaluator_binding", "artifact_manifest_binding", "trusted_checkpoint_canonical_path", "append_not_before_utc"],
  "properties": {
    "schema_version": {"const": "shared-pa-experiment-registry-release-expectation-v1"},
    "authority_id": {"type": "string", "minLength": 1},
    "registry_id": {"const": "shared_pa_experiment_registry_v1"},
    "source_base_commit": {"const": "9f9d839187550f7a7a6da3b4bfdb25b2dff3e794"},
    "policy_binding": {"$ref": "#/$defs/binding"},
    "evaluator_binding": {"$ref": "#/$defs/binding"},
    "artifact_manifest_binding": {"$ref": "#/$defs/binding"},
    "trusted_checkpoint_canonical_path": {"type": "string", "minLength": 1},
    "append_not_before_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
