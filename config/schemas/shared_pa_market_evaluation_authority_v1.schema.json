{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-pa-market-evaluation-authority-v1",
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authority_id", "contract_sha256", "registry_checkpoint_sha256", "candidate_frozen_entry_sha256", "baseline_artifact_manifest_sha256", "dataset_manifest_sha256", "settlement_manifest_sha256", "market_source_authority_manifest_sha256", "evidence_window_id", "materiality_policy_sha256", "issued_at_utc"],
  "properties": {
    "schema_version": {"const": "shared-pa-market-evaluation-authority-v1"},
    "authority_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "registry_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_frozen_entry_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "settlement_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "market_source_authority_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_window_id": {"type": "string", "minLength": 1},
    "materiality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
