{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-pa-official-2023-outcome-label-release-v1.schema.json",
  "title": "Shared-PA official 2023 outcome-label row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_pk",
    "official_date",
    "team_side",
    "team_id",
    "player_id",
    "starter",
    "lineup_slot",
    "plate_appearances",
    "at_bats",
    "hits",
    "singles",
    "doubles",
    "triples",
    "home_runs",
    "base_on_balls",
    "intentional_walks",
    "non_intentional_walks",
    "strikeouts",
    "hit_by_pitch",
    "sac_flies",
    "sac_bunts",
    "total_bases",
    "runs",
    "rbi",
    "catcher_interference",
    "non_hit_non_strikeout_at_bats",
    "other_official_pa",
    "source_response_sha256",
    "source_receipt_sha256"
  ],
  "properties": {
    "game_pk": {"type": "integer", "minimum": 1},
    "official_date": {"type": "string", "pattern": "^2023-[0-9]{2}-[0-9]{2}$"},
    "team_side": {"enum": ["away", "home"]},
    "team_id": {"type": "integer", "minimum": 1},
    "player_id": {"type": "integer", "minimum": 1},
    "starter": {"type": "boolean"},
    "lineup_slot": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
    "plate_appearances": {"type": "integer", "minimum": 0},
    "at_bats": {"type": "integer", "minimum": 0},
    "hits": {"type": "integer", "minimum": 0},
    "singles": {"type": "integer", "minimum": 0},
    "doubles": {"type": "integer", "minimum": 0},
    "triples": {"type": "integer", "minimum": 0},
    "home_runs": {"type": "integer", "minimum": 0},
    "base_on_balls": {"type": "integer", "minimum": 0},
    "intentional_walks": {"type": "integer", "minimum": 0},
    "non_intentional_walks": {"type": "integer", "minimum": 0},
    "strikeouts": {"type": "integer", "minimum": 0},
    "hit_by_pitch": {"type": "integer", "minimum": 0},
    "sac_flies": {"type": "integer", "minimum": 0},
    "sac_bunts": {"type": "integer", "minimum": 0},
    "total_bases": {"type": "integer", "minimum": 0},
    "runs": {"type": "integer", "minimum": 0},
    "rbi": {"type": "integer", "minimum": 0},
    "catcher_interference": {"type": "integer", "minimum": 0},
    "non_hit_non_strikeout_at_bats": {"type": "integer", "minimum": 0},
    "other_official_pa": {"type": "integer", "minimum": 0},
    "source_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

