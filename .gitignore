# Project-specific
# Ignore bulky/transient data at the repo root, but KEEP the learning
# artifacts the self-improvement loop and CI automation must persist
# (prediction archive, graded pairs, reports).
#
# gitignore rule: to un-ignore a nested path you must re-include EVERY
# parent directory first, before the child, and not use a trailing-slash
# ignore on a parent you want to descend into. Order matters.
/data/*
!/data/.gitkeep
# Re-include the learning + predictions subtrees the automation writes.
!/data/learning/
/data/learning/*
!/data/learning/prediction_outcomes.csv
!/data/learning/predictions/
!/data/learning/predictions/*
!/data/predictions/
!/data/predictions/*
# A3 training set: track only the small manifests; shards, assembled
# sets, and the regenerable HTTP cache stay OUT.
!/data/training/
/data/training/*
!/data/training/manifest_*.json
# Bulky caches / secrets that live under those trees stay OUT.
/data/learning/bias_corrections.json
# reports/ is written by the weekly validation workflow.
!/reports/
!/reports/*
cache/
*.log
config/local*.json
# Stray ad-hoc exports at the repo ROOT only (anchored). Unanchored
# versions of these matched data/learning/predictions/predictions_*.json
# and silently overrode the re-includes above — archives were never
# committable, so CI could never grade them.
/predictions_*.csv
/predictions_*.txt
/predictions_*.json

# A3 training-set builder: HTTP cache is bulk/regenerable; training shards
# and assembled sets are large. Keep the manifests (small provenance).
/data/cache/
/data/training/*/
/data/training/training_*.csv.gz
!/data/training/manifest_*.json

__pycache__/
*.pyc
catboost_info/
